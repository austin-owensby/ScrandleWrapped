{
  "name": "scrandle-wrapped",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run prepare && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prepare": "node prepare.js",
    "deploy": "npm run prepare && ng deploy --base-href=/ScrandleWrapped/"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "angular-cli-ghpages": "^3.1.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
